// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  username        String   @unique
  avatarUrl       String?
  githubId        String?  @unique
  githubUsername  String?  @unique
  githubToken     String?  // encrypted
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft delete

  // Relations
  cvs             CV[]
  exports         Export[]

  @@index([email])
  @@index([githubUsername])
  @@map("users")
}

// ─── CV ───────────────────────────────────────────────────────────────────────

model CV {
  id          String    @id @default(cuid())
  userId      String
  title       String    @default("My CV")
  slug        String    @unique // for public URL: /cv/username-slug
  templateId  String
  isPublic    Boolean   @default(false)
  status      CVStatus  @default(DRAFT)
  viewCount   Int       @default(0)
  
  // CV Content stored as JSON
  content     Json      @default("{}")
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  template    Template  @relation(fields: [templateId], references: [id])
  exports     Export[]

  @@index([userId])
  @@index([slug])
  @@index([isPublic, status])
  @@map("cvs")
}

enum CVStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─── Templates ────────────────────────────────────────────────────────────────

model Template {
  id          String           @id @default(cuid())
  name        String
  description String?
  previewUrl  String?
  category    TemplateCategory
  isPremium   Boolean          @default(false)
  isActive    Boolean          @default(true)
  tags        String[]
  sortOrder   Int              @default(0)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  cvs         CV[]

  @@map("templates")
}

enum TemplateCategory {
  MINIMAL
  MODERN
  CREATIVE
  CLASSIC
}

// ─── Exports ──────────────────────────────────────────────────────────────────

model Export {
  id        String       @id @default(cuid())
  cvId      String
  userId    String
  format    ExportFormat
  fileUrl   String?      // R2 URL after generation
  status    ExportStatus @default(PENDING)
  error     String?
  
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  cv        CV           @relation(fields: [cvId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cvId])
  @@index([userId])
  @@map("exports")
}

enum ExportFormat {
  PDF
  DOCX
  JSON
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
