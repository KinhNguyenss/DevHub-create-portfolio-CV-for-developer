{
  "name": "@devhub/api",
  "version": "0.0.1",
  "description": "DevHub API — NestJS backend",
  "author": "",
  "overrides": {
    "@nestjs/config": { "@nestjs/common": "$@nestjs/common" },
    "@nestjs/jwt": { "@nestjs/common": "$@nestjs/common" },
    "@nestjs/passport": { "@nestjs/common": "$@nestjs/common" },
    "@nestjs/bullmq": { "@nestjs/common": "$@nestjs/common" }
  },
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-github2": "^0.1.12",
    "@prisma/client": "^6.7.0",
    "@nestjs/bullmq": "^11.0.2",
    "bullmq": "^5.52.2",
    "@langchain/core": "^0.3.55",
    "@langchain/openai": "^0.5.10",
    "@langchain/google-genai": "^0.2.8",
    "langchain": "^0.3.27",
    "puppeteer": "^24.6.1",
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "zod": "^3.24.2",
    "class-validator": "^0.14.2",
    "class-transformer": "^0.5.1",
    "ioredis": "^5.6.0",
    "axios": "^1.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-github2": "^1.2.9",
    "@types/passport": "^1.0.17",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^6.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
