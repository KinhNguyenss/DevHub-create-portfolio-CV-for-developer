# =============================================================
# DevHub — Environment Variables Example
# Copy to .env and fill in actual values
# NEVER commit .env to git
# =============================================================

# -----------------------------------------------
# DATABASE (PostgreSQL via Supabase)
# -----------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/devhub?schema=public"

# -----------------------------------------------
# AUTH (NextAuth.js v5 + GitHub OAuth)
# -----------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET="your-nextauth-secret-here"
AUTH_URL="http://localhost:3000"

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# -----------------------------------------------
# BACKEND API
# -----------------------------------------------
API_PORT=4000
API_BASE_URL="http://localhost:4000"

# JWT (Backend — for API authentication)
# Generate: openssl rand -base64 64
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"
JWT_REFRESH_EXPIRES_IN="30d"

# -----------------------------------------------
# REDIS (Upstash — Queue + Cache)
# Get from: https://console.upstash.com
# -----------------------------------------------
REDIS_URL="redis://localhost:6379"
# For Upstash: rediss://default:PASSWORD@HOST:PORT

# -----------------------------------------------
# AI — OpenAI (Primary LLM)
# Get from: https://platform.openai.com/api-keys
# -----------------------------------------------
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"

# -----------------------------------------------
# AI — Google Gemini (Fallback LLM)
# Get from: https://aistudio.google.com/apikey
# -----------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-pro"

# -----------------------------------------------
# FILE STORAGE (Cloudflare R2 — S3 compatible)
# Get from: https://dash.cloudflare.com -> R2
# -----------------------------------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="devhub-exports"
R2_PUBLIC_URL="https://your-r2-public-url.r2.dev"
# R2 endpoint (required for S3-compatible SDK)
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# -----------------------------------------------
# GITHUB API
# -----------------------------------------------
# OAuth scopes to request: read:user public_repo
GITHUB_API_BASE_URL="https://api.github.com"

# -----------------------------------------------
# APP CONFIG
# -----------------------------------------------
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
